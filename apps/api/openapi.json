{
  "openapi": "3.0.3",
  "info": {
    "title": "hiphouse API",
    "description": "크롤러가 채운 Postgres(artists/albums) CRUD 서버.",
    "version": "0.1.0"
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "albums" },
    { "name": "artists" },
    { "name": "users" }
  ],
  "paths": {
    "/albums": {
      "get": {
        "tags": ["albums"],
        "summary": "앨범 목록 (연도/아티스트 필터)",
        "parameters": [
          { "name": "year", "in": "query", "schema": { "type": "integer" }, "description": "발매 연도로 필터" },
          { "name": "artist_id", "in": "query", "schema": { "type": "string" }, "description": "아티스트 ID로 필터" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "검색어 — 앨범명(한글 표시 이름 포함), 크레딧 아티스트명(한글 표시 이름 포함), 아티스트 연관검색어(aliases), 트랙명(한글 표시 이름 포함)에 매칭" },
          { "name": "deleted", "in": "query", "schema": { "type": "string", "enum": ["only"] }, "description": "only = 소프트삭제된 앨범만 (관리자 전용; 비관리자에겐 무시됨)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0, "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "앨범 배열",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Album" } } } }
          }
        }
      },
      "post": {
        "tags": ["albums"],
        "summary": "앨범 생성",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Album" } } }
        },
        "responses": {
          "201": { "description": "생성됨", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Album" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "description": "id 중복", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/albums/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "tags": ["albums"],
        "summary": "앨범 단건 조회",
        "responses": {
          "200": { "description": "앨범", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Album" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["albums"],
        "summary": "앨범 수정 (전체 교체)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Album" } } }
        },
        "responses": {
          "200": { "description": "수정됨", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Album" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["albums"],
        "summary": "앨범 삭제",
        "responses": {
          "204": { "description": "삭제됨" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/albums/{id}/tracks": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "tags": ["albums"],
        "summary": "앨범 트랙 목록 (관리자 전용)",
        "description": "disc_number, track_number 순 정렬. 아직 트랙 동기화 전인 앨범은 빈 배열. 일반 사용자에게는 노출하지 않는다 — 웹은 Spotify 임베드로 트랙리스트를 보여준다.",
        "responses": {
          "200": { "description": "트랙 배열", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Track" } } } } }
        }
      }
    },
    "/albums/{id}/tracks/{trackId}/display-name": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "trackId", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "put": {
        "tags": ["albums"],
        "summary": "트랙 한글 표시 이름만 교체 (관리자 전용)",
        "description": "동기화(백필)가 관리하는 필드는 건드리지 않는다. 빈 문자열/null이면 해제되어 Spotify 원본명으로 표시된다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "display_name": { "type": "string", "nullable": true, "example": "새삥" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "수정됨" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/albums/{id}/display-name": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "put": {
        "tags": ["albums"],
        "summary": "앨범 한글 표시 이름만 교체 (관리자 전용)",
        "description": "크롤러가 관리하는 필드는 건드리지 않는다. 빈 문자열/null이면 해제되어 Spotify 원본명으로 표시된다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "display_name": { "type": "string", "nullable": true, "example": "새삥" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "수정됨" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/albums/{id}/info": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "put": {
        "tags": ["albums"],
        "summary": "앨범 메타(원제/발매일/유형/트랙 수) 수정 (관리자 전용)",
        "description": "Spotify 발매일이 실제와 다른 앨범을 바로잡는 용도. 저장하면 info_edited_at이 찍혀 이후 Spotify 재동기화·크롤러가 이 앨범 행을 덮어쓰지 않는다. year는 release_date 앞 4자리에서 자동 산출. release_date/album_type을 비우면 null.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "The Blueprint" },
                  "release_date": { "type": "string", "nullable": true, "description": "YYYY | YYYY-MM | YYYY-MM-DD", "example": "2001-09-11" },
                  "album_type": { "type": "string", "nullable": true, "enum": ["album", "single", "compilation"] },
                  "total_tracks": { "type": "integer", "nullable": true, "minimum": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "수정됨" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["users"],
        "summary": "공개 프로필",
        "description": "닉네임·가입일과 평가/댓글 집계. 로그인 없이 조회 가능. user_id와 nickname은 댓글 API가 이미 공개하는 값이다. 프로필 비공개(profile_public=false)면 활동 집계 셋(rating_count/rating_avg/comment_count)이 모두 0/null로 가려지고 닉네임·가입일만 남는다. 단 Bearer 토큰의 주인이 이 프로필 본인이면 비공개여도 집계가 그대로 나간다.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "프로필",
            "content": { "application/json": { "schema": { "type": "object", "properties": {
              "id": { "type": "string" }, "nickname": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" },
              "profile_public": { "type": "boolean", "description": "false = 주인이 프로필을 비공개로 설정. 남에게는 이 프로필의 활동 집계와 평가 목록이 전부 가려진다(주인 본인에게는 그대로 보인다). 팔로우·즐겨찾기는 공개 엔드포인트 자체가 없어 이 플래그와 무관하게 항상 비공개" },
              "rating_count": { "type": "integer" },
              "rating_avg": { "type": "number", "nullable": true, "description": "별점 0..5. 평가가 없으면 null" },
              "comment_count": { "type": "integer" }
            } } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}/ratings": {
      "get": {
        "tags": ["users"],
        "summary": "그 사용자가 평가한 앨범",
        "description": "앨범 행에 그 사용자가 준 score(하프스타 1..10)를 얹어 최근 평가순으로 반환. 삭제된 앨범은 제외. 프로필 비공개 사용자는 빈 배열 — 비공개인지 평가가 없는지는 GET /users/{id}의 profile_public으로 구분한다. Bearer 토큰의 주인이 이 프로필 본인이면 비공개여도 목록이 그대로 나간다.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "앨범 배열 (Album + score)",
            "content": { "application/json": { "schema": { "type": "array", "items": {
              "allOf": [
                { "$ref": "#/components/schemas/Album" },
                { "type": "object", "properties": { "score": { "type": "integer", "minimum": 1, "maximum": 10 } } }
              ]
            } } } }
          }
        }
      }
    },
    "/og/albums/{id}": {
      "get": {
        "tags": ["albums"],
        "summary": "링크 스크래퍼용 메타 프리렌더 (HTML)",
        "description": "og:/twitter: 메타만 담은 HTML을 반환한다. nginx가 스크래퍼 User-Agent의 /albums/{id} 요청만 여기로 넘기고 사람은 SPA를 받는다. og:url·canonical은 PUBLIC_ORIGIN(없으면 X-Forwarded-Proto/Host)으로 만든다. 삭제되었거나 없는 앨범은 404.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "메타 태그 HTML", "content": { "text/html": { "schema": { "type": "string" } } } },
          "404": { "description": "없거나 삭제된 앨범" }
        }
      }
    },
    "/artists": {
      "get": {
        "tags": ["artists"],
        "summary": "아티스트 목록",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "검색어 — 아티스트명, 한글 표시 이름, 또는 연관검색어(aliases)에 매칭" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0, "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "아티스트 배열",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Artist" } } } }
          }
        }
      },
      "post": {
        "tags": ["artists"],
        "summary": "아티스트 생성",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } }
        },
        "responses": {
          "201": { "description": "생성됨", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "description": "id 중복", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/artists/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "tags": ["artists"],
        "summary": "아티스트 단건 조회",
        "responses": {
          "200": { "description": "아티스트", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["artists"],
        "summary": "아티스트 수정",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } }
        },
        "responses": {
          "200": { "description": "수정됨", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["artists"],
        "summary": "아티스트 삭제",
        "responses": {
          "204": { "description": "삭제됨" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/spotify/keys": {
      "get": {
        "tags": ["artists"],
        "summary": "설정된 Spotify 자격증명 키 목록 (관리자)",
        "description": "<PREFIX>_SPOTIFY_CLIENT_ID/SECRET 쌍이 존재하는 접두사들을 소문자로 반환 (예: [\"first\",\"second\",\"third\"]).",
        "responses": {
          "200": { "description": "키 배열", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } } }
        }
      }
    },
    "/admin/spotify/artists": {
      "get": {
        "tags": ["artists"],
        "summary": "Spotify 아티스트 검색 (관리자 크롤링용)",
        "description": "Spotify 검색 후보에 우리 DB의 앨범 보유 수(albums_in_db)를 붙여 반환. key로 FIRST_/SECOND_ 자격증명 선택.",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "key", "in": "query", "schema": { "type": "string", "enum": ["first", "second"] } }
        ],
        "responses": {
          "200": {
            "description": "후보 배열",
            "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": {
              "id": { "type": "string" }, "name": { "type": "string" },
              "image_url": { "type": "string", "nullable": true },
              "followers": { "type": "integer" }, "albums_in_db": { "type": "integer" }
            } } } } }
          }
        }
      }
    },
    "/admin/spotify/crawl": {
      "post": {
        "tags": ["artists"],
        "summary": "아티스트 앨범 크롤 (관리자)",
        "description": "해당 아티스트의 전체 앨범을 Spotify에서 가져와 저장. 앨범 0개면 아티스트를 저장하지 않음. 크레딧 아티스트 중 이미지 없는 것만 개별 enrich. 트랙 미동기화 앨범(신규 포함)은 트랙까지 같이 수집. appears_on=true면 참여·컴필레이션 앨범(include_groups=appears_on,compilation)까지 포함 — 노이즈가 많아 기본은 꺼짐.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["artist_id"], "properties": {
            "artist_id": { "type": "string" },
            "key": { "type": "string", "enum": ["first", "second"] },
            "appears_on": { "type": "boolean", "default": false, "description": "참여·컴필레이션 앨범 포함 여부" }
          } } } }
        },
        "responses": {
          "200": { "description": "크롤 결과 {albums, saved, artist_name, artists, enriched, tracks_synced}" },
          "502": { "description": "Spotify API 오류", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/admin/spotify/albums": {
      "get": {
        "tags": ["albums"],
        "summary": "Spotify 앨범 검색 (관리자 크롤링용)",
        "description": "앨범명으로 Spotify를 검색해 후보를 반환. 장르 필터가 없으므로 관리자가 직접 골라 담는 용도. in_db는 우리 DB에 이미 있는지, deleted는 그 행이 소프트 삭제 상태인지를 뜻한다.",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" }, "description": "앨범명. Spotify 쿼리 문법(artist:, year:) 사용 가능." },
          { "name": "key", "in": "query", "schema": { "type": "string", "enum": ["first", "second"] } }
        ],
        "responses": {
          "200": {
            "description": "후보 배열",
            "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": {
              "id": { "type": "string" }, "name": { "type": "string" },
              "image_url": { "type": "string", "nullable": true },
              "release_date": { "type": "string", "nullable": true },
              "album_type": { "type": "string", "nullable": true },
              "total_tracks": { "type": "integer" },
              "artists": { "type": "string", "description": "크레딧 아티스트명 쉼표 연결" },
              "in_db": { "type": "boolean" }, "deleted": { "type": "boolean" }
            } } } } }
          },
          "502": { "description": "Spotify API 오류", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/admin/spotify/crawl-album": {
      "post": {
        "tags": ["albums"],
        "summary": "앨범 단건 추가 (관리자)",
        "description": "앨범 검색에서 고른 앨범 1개를 저장. 저장 경로는 아티스트 크롤과 동일(앨범 행 + 크레딧 아티스트 + 조인 행, 이후 enrich·트랙 동기화). 소프트 삭제된 앨범의 deleted_at은 건드리지 않으며 그 경우 응답 deleted가 true다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["album_id"], "properties": {
            "album_id": { "type": "string" },
            "key": { "type": "string", "enum": ["first", "second"] }
          } } } }
        },
        "responses": {
          "200": { "description": "추가 결과 {album_id, album_name, saved, artists, enriched, tracks_synced, deleted}" },
          "502": { "description": "Spotify API 오류", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/admin/spotify/releases-status": {
      "get": {
        "tags": ["artists"],
        "summary": "신보 체크 현황 (관리자)",
        "description": "artists = 신보 감시(releases_watch)가 켜진 체크 대상 아티스트 수, stale = 이번 주기(20시간) 내 아직 확인하지 않은 아티스트 수.",
        "responses": {
          "200": { "description": "{artists, stale}", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "artists": { "type": "integer" }, "stale": { "type": "integer" }
          } } } } }
        }
      }
    },
    "/admin/spotify/check-releases": {
      "post": {
        "tags": ["artists"],
        "summary": "신보 감지 배치 실행 (관리자)",
        "description": "신보 감시(releases_watch)가 켜진 아티스트를 오래 안 본 순서대로 최대 limit명 확인 (아티스트당 Spotify 요청 1회 — 앨범 목록 첫 페이지 10장). DB에 없는 앨범만 저장하고 enrich·트랙 동기화까지 이어서 수행. 소프트 삭제된 앨범은 되살리지 않는다. Spotify 오류 시 배치를 중단하고 진행분과 함께 error로 보고 — 실패한 아티스트는 다음 호출이 다시 집는다. remaining이 0이 될 때까지 반복 호출.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "key": { "type": "string", "enum": ["first", "second"] },
            "limit": { "type": "integer", "default": 10, "minimum": 1, "maximum": 50, "description": "배치당 확인할 아티스트 수" }
          } } } }
        },
        "responses": {
          "200": { "description": "{checked, new_albums, enriched, tracks_synced, remaining, artists:[{id,name,albums:[이름]}], error?}" }
        }
      }
    },
    "/admin/tracks/status": {
      "get": {
        "tags": ["albums"],
        "summary": "트랙 동기화 현황 (관리자)",
        "description": "삭제되지 않은 앨범 기준. missing = 트랙 또는 앨범 메타(upc/copyrights/발매일 정밀도)를 아직 받아오지 않은 앨범 수, tracks = 저장된 전체 트랙 행 수.",
        "responses": {
          "200": { "description": "{albums, synced, missing, tracks}", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "albums": { "type": "integer" }, "synced": { "type": "integer" },
            "missing": { "type": "integer" }, "tracks": { "type": "integer" }
          } } } } }
        }
      }
    },
    "/admin/tracks/backfill": {
      "post": {
        "tags": ["albums"],
        "summary": "트랙 백필 배치 실행 (관리자)",
        "description": "트랙 미동기화 또는 앨범 메타(upc/copyrights/발매일 정밀도) 미수집 앨범을 최신 발매순으로 최대 limit개 처리 (앨범당 Spotify 요청 1회, 앨범별 커밋) — 같은 full object 응답에서 트랙과 메타를 함께 저장한다. 404 앨범은 빈 트랙으로 완료 처리. 그 외 Spotify 오류는 배치를 중단하고 진행분과 함께 error로 보고. remaining이 0이 될 때까지 반복 호출.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "key": { "type": "string", "enum": ["first", "second"] },
            "limit": { "type": "integer", "default": 20, "minimum": 1, "maximum": 50 }
          } } } }
        },
        "responses": {
          "200": { "description": "{synced, not_found, tracks, remaining, albums:[{id,name,tracks,not_found}], error?}" }
        }
      }
    },
    "/artists/merge": {
      "post": {
        "tags": ["artists"],
        "summary": "아티스트 병합 (관리자 전용)",
        "description": "merged_ids의 앨범 크레딧을 master로 이동하고, 이름·연관검색어를 master의 연관검색어로 흡수한 뒤 중복 아티스트를 삭제한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["master_id", "merged_ids"],
                "properties": {
                  "master_id": { "type": "string" },
                  "merged_ids": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "병합된 master 아티스트", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/artists/{id}/aliases": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "put": {
        "tags": ["artists"],
        "summary": "연관검색어(aliases)만 교체 (관리자 전용)",
        "description": "크롤러가 관리하는 필드(name/image/genres/spotify_url)는 건드리지 않고 aliases만 바꾼다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["aliases"],
                "properties": {
                  "aliases": { "type": "array", "items": { "type": "string" }, "example": ["블랙넛", "블넛"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "수정된 아티스트", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Artist" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/artists/{id}/display-name": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "put": {
        "tags": ["artists"],
        "summary": "아티스트 한글 표시 이름만 교체 (관리자 전용)",
        "description": "크롤러가 관리하는 필드(name/image/genres/spotify_url)는 건드리지 않는다. 빈 문자열/null이면 해제되어 Spotify 원본명으로 표시된다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "display_name": { "type": "string", "nullable": true, "example": "지코" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "수정됨" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/artists/{id}/releases-watch": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "put": {
        "tags": ["artists"],
        "summary": "신보 감시 플래그만 교체 (관리자 전용)",
        "description": "신보 체크 대상 여부. 다른 필드는 건드리지 않는다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["watch"],
                "properties": {
                  "watch": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "수정됨" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": { "description": "잘못된 요청", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "없음", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Album": {
        "type": "object",
        "required": ["id", "name", "artists"],
        "properties": {
          "id": { "type": "string", "example": "4aawyAB9vmqN3uQ7FjRGTy" },
          "name": { "type": "string", "example": "Album Name" },
          "display_name": { "type": "string", "nullable": true, "example": "새삥", "description": "관리자가 등록한 한글 표시 이름. 없으면 name으로 표시하고, 검색 시 name과 함께 매칭됨" },
          "artists": {
            "type": "array",
            "description": "크레딧된 모든 아티스트 (Spotify 순서). album_artists 조인에서 집계.",
            "items": { "$ref": "#/components/schemas/Artist" }
          },
          "release_date": { "type": "string", "nullable": true, "example": "2024-05-01" },
          "year": { "type": "integer", "nullable": true, "example": 2024 },
          "album_type": { "type": "string", "nullable": true, "example": "album" },
          "total_tracks": { "type": "integer", "nullable": true, "example": 12 },
          "image_url": { "type": "string", "nullable": true },
          "spotify_url": { "type": "string", "nullable": true }
        }
      },
      "Artist": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "example": "1uNFoZAHBGtllmzznpCI3s" },
          "name": { "type": "string", "nullable": true, "example": "Artist Name" },
          "display_name": { "type": "string", "nullable": true, "example": "지코", "description": "관리자가 등록한 한글 표시 이름. 없으면 name으로 표시하고, 검색 시 name과 함께 매칭됨" },
          "image_url": { "type": "string", "nullable": true, "description": "Spotify 아티스트 사진 (없을 수 있음)" },
          "genres": { "type": "array", "items": { "type": "string" }, "nullable": true, "description": "Spotify 아티스트 장르 (비어있을 수 있음)" },
          "spotify_url": { "type": "string", "nullable": true, "description": "Spotify 아티스트 프로필 URL" },
          "aliases": { "type": "array", "items": { "type": "string" }, "nullable": true, "description": "연관검색어 — 관리자가 등록한 검색 키워드 (예: 영문명의 한글 표기). 검색 시 name과 함께 매칭됨" },
          "followers": { "type": "integer", "nullable": true, "description": "Spotify 팔로워 수 — 크롤러/enrich가 채움 (아직 수집 전이면 null). 화면 표시용이 아니라 관리자 enrich 판단용" },
          "releases_watch": { "type": "boolean", "description": "신보 감시 대상 여부 — 신보 체크가 이 플래그 켜진 아티스트만 확인. 관리자 토글 소유" },
          "follower_count": { "type": "integer", "description": "서비스 내부 팔로워 수 — follows 테이블 집계" }
        }
      },
      "Track": {
        "type": "object",
        "required": ["id", "disc_number", "track_number", "name", "explicit", "artists"],
        "properties": {
          "id": { "type": "string", "example": "3n3Ppam7vgaVa1iaRUc9Lp" },
          "disc_number": { "type": "integer", "example": 1 },
          "track_number": { "type": "integer", "example": 3 },
          "name": { "type": "string", "example": "Track Name" },
          "display_name": { "type": "string", "nullable": true, "description": "관리자가 등록한 한글 표시 이름 — null이면 name으로 표시" },
          "duration_ms": { "type": "integer", "nullable": true, "example": 207959 },
          "explicit": { "type": "boolean" },
          "spotify_url": { "type": "string", "nullable": true },
          "artists": {
            "type": "array",
            "description": "참여 아티스트 (피처링 포함, Spotify 크레딧 순서)",
            "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
