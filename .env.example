# hiphouse — 전체 앱 공용 환경변수 (루트 한 곳에서 관리)
# 복사: cp .env.example .env  후 값 채우기
# 로드 방식: api(Go 자체 로더), crawler(node --env-file), web(Vite envDir=루트)
# 실제 셸 환경변수가 있으면 그 값이 우선.

# --- 공통 / DB ---
# DATABASE_URL=postgres://hiphouse:hiphouse@localhost:5432/hiphouse

# --- 프로덕션 배포 (docker-compose.prod.yml) ---
# GitHub owner (소문자). ghcr.io/<owner>/hiphouse-* 이미지 경로
# GH_OWNER=devcdd
# 운영 DB 자격증명 (기본값과 다르게 설정 권장)
# POSTGRES_USER=hiphouse
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=hiphouse

# --- API 서버 (apps/api) ---
# PORT=8080
# JWT 서명 키 (운영에서는 반드시 랜덤 값으로 교체)
# JWT_SECRET=change-me
# 관리자로 승격할 카카오 사용자 id (콤마 구분)
# ADMIN_KAKAO_IDS=1234567890,2345678901
# 카카오 로그인 (개발자 콘솔 > REST API 키)
# KAKAO_REST_API_KEY=
# 카카오 보안 > Client Secret 사용 시에만
# KAKAO_CLIENT_SECRET=
# 링크 공유 카드(og:url·canonical)에 박히는 공개 주소. 비워두면 nginx가 넘겨주는
# X-Forwarded-Proto/Host로 만든다 — 도메인이 여러 개거나 프록시가 헤더를 안 주면 지정.
# PUBLIC_ORIGIN=https://hiphouse.kr

# --- 크롤러 (apps/crawler) + API 크롤 엔드포인트 ---
# 기본 키. <이름>_SPOTIFY_CLIENT_* 접두사 쌍을 몇 개든 추가해두고
# --key=first / --key=second / --key=third ... (웹 관리자 페이지에서는 토글이
# 자동 생성됨)로 어떤 Spotify 앱 자격증명을 쓸지 선택 가능.
# 키 미지정 시: SPOTIFY_* → 없으면 FIRST_SPOTIFY_* 순으로 사용.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# FIRST_SPOTIFY_CLIENT_ID=
# FIRST_SPOTIFY_CLIENT_SECRET=
# SECOND_SPOTIFY_CLIENT_ID=
# SECOND_SPOTIFY_CLIENT_SECRET=
# MARKET=KR

# --- Apple Music API (카탈로그 조회 · 신보 스윕 · 레이블/장르 enrich) ---
# 개발자 포털 > Keys > + > MusicKit 체크로 발급. .p8은 한 번만 내려받을 수 있고
# 리포에 절대 커밋하지 말 것. 카탈로그 조회는 developer token만으로 충분(사용자 로그인 불필요).
# Team ID (10자, Membership 페이지)
# APPLE_MUSIC_TEAM_ID=
# Key ID (10자, 키 생성 화면)
# APPLE_MUSIC_KEY_ID=
# 내려받은 AuthKey_<KEY_ID>.p8 절대 경로 (api 개발 서버 cwd가 apps/api라 상대 경로는 깨짐). 도커에서는 마운트한 경로
# APPLE_MUSIC_PRIVATE_KEY_PATH=/absolute/path/to/secrets/AuthKey_XXXXXXXXXX.p8
# 스토어프론트(ISO 3166 alpha-2). 응답 로컬라이즈는 l=ko 쿼리로 별도 지정
# APPLE_MUSIC_STOREFRONT=kr

# --- 웹 (apps/web) — VITE_ 접두사만 클라이언트로 노출됨 ---
# VITE_KAKAO_REST_API_KEY=
# VITE_API_BASE=/api
